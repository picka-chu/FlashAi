# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Fallback/Rotation Keys for Gemini (Optional)
GEMINI_API_KEY_1=
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=
GEMINI_API_KEY_4=
GEMINI_API_KEY_5=

# FOOTBALL_API_KEY: Legacy key used by existing football API integrations.
FOOTBALL_API_KEY=
# FOOTBALL_API_KEYS: Comma-separated list of fallback API keys.
FOOTBALL_API_KEYS=
# SPORTS_API_KEY: Backend-only key used by /api/football endpoints.
SPORTS_API_KEY=
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# TELEGRAM_BOT_TOKEN: The token for your Telegram bot.
# Obtain this from @BotFather on Telegram.
TELEGRAM_BOT_TOKEN="YOUR_TELEGRAM_BOT_TOKEN"

# ADMIN_TELEGRAM_ID: The Telegram ID of the primary admin user.
ADMIN_TELEGRAM_ID=

# AUTOMATION_SECRET: Secret key for external automation triggers (n8n/github actions)
AUTOMATION_SECRET=

# SUPABASE_URL: Your Supabase project URL.
SUPABASE_URL="YOUR_SUPABASE_URL"

# SUPABASE_ANON_KEY: Your Supabase anonymous API key.
SUPABASE_ANON_KEY="YOUR_SUPABASE_ANON_KEY"

# PORT: Render/hosting will inject this automatically in production.
PORT=3000

# TON_RECEIVER_ADDRESS: The wallet address where TON payments will be sent.
TON_RECEIVER_ADDRESS="UQB1vS8u8a4S6X2m7S7_K3X-QO-V6aX7L-u1tS7K-aX7-a-z"
# TONCENTER_API_KEY: API key for Toncenter transaction verification polling.
TONCENTER_API_KEY=
