# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Fallback/Rotation Keys for Gemini (Optional)
GEMINI_API_KEY_1=
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=
GEMINI_API_KEY_4=
GEMINI_API_KEY_5=

# FOOTBALL_API_KEY: Primary API key for api-sports.io or RapidAPI
FOOTBALL_API_KEY=
# FOOTBALL_API_KEYS: Comma-separated list of fallback API keys
FOOTBALL_API_KEYS=""
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# TELEGRAM_BOT_TOKEN: The token for your Telegram bot.
# Obtain this from @BotFather on Telegram.
TELEGRAM_BOT_TOKEN="YOUR_TELEGRAM_BOT_TOKEN"

# SUPABASE_URL: Your Supabase project URL.
SUPABASE_URL="YOUR_SUPABASE_URL"

# SUPABASE_ANON_KEY: Your Supabase anonymous API key.
SUPABASE_ANON_KEY="YOUR_SUPABASE_ANON_KEY"

# Session signing secrets (required for Telegram auth exchange flow)
APP_SESSION_SECRET="REPLACE_WITH_LONG_RANDOM_SECRET"
APP_REFRESH_SECRET="REPLACE_WITH_LONG_RANDOM_SECRET"
