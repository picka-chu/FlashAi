# =============================================================================
# Flash AI environment configuration
# Copy to `.env` and fill in real values. Never commit `.env`.
# =============================================================================

# -----------------------------------------------------------------------------
# Runtime
# -----------------------------------------------------------------------------
NODE_ENV=development
PORT=3000
LOG_LEVEL=info
# APP_URL is used for self-referential links, OAuth callbacks and bot buttons.
APP_URL="http://localhost:3000"
# Used by the bot when APP_URL is not set.
DEFAULT_APP_URL=
# Set to "true" only when running behind a trusted reverse proxy (Render, etc.).
# When false, rate limiting uses the socket address instead of X-Forwarded-For.
TRUST_PROXY=false
# Timezone used for daily credit resets / reports.
TIMEZONE=UTC

# -----------------------------------------------------------------------------
# Supabase (required)
# -----------------------------------------------------------------------------
SUPABASE_URL="YOUR_SUPABASE_URL"
SUPABASE_ANON_KEY="YOUR_SUPABASE_ANON_KEY"
# Backend-only. Never expose this to the client.
SUPABASE_SERVICE_ROLE_KEY=

# -----------------------------------------------------------------------------
# Telegram bot (required)
# -----------------------------------------------------------------------------
TELEGRAM_BOT_TOKEN="YOUR_TELEGRAM_BOT_TOKEN"
# Username without the @, e.g. FlashAiBot
TELEGRAM_BOT_USERNAME=
ADMIN_TELEGRAM_ID=
# Reject initData older than this many seconds (default 86400 = 24h).
TELEGRAM_INIT_DATA_MAX_AGE_SECONDS=86400

# -----------------------------------------------------------------------------
# AI keys
# Primary prediction keys (highest priority)
GEMINI_PREDICTION_KEY_1=
GEMINI_PREDICTION_KEY_2=
GEMINI_PREDICTION_KEY_3=
# Agent keys (multi-agent workflows)
GEMINI_AGENT_KEY_1=
GEMINI_AGENT_KEY_2=
# General fallback keys
GEMINI_API_KEY_1=
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=
GEMINI_API_KEY_4=
GEMINI_API_KEY_5=
# Optional dedicated support key (falls back to the rotation above)
GEMINI_SUPPORT_KEY=
GEMINI_SUPPORT_KEY_1=
# Used when no rotation keys are configured
GEMINI_API_KEY=
GOOGLE_AI_API_KEY=

# -----------------------------------------------------------------------------
# Football / sports data APIs
# ESPN is free and requires no key. BSD (Bzzoiro) is the primary paid feed.
# -----------------------------------------------------------------------------
# BSD / Bzzoiro (primary: live events, stats, xG, odds)
BSD_API_KEY=
BSD_FOOTBALL_API_KEY=
# Defaults to https://sports.bzzoiro.com/api when unset.
BSD_API_BASE=https://sports.bzzoiro.com/api

# SportsAPI Pro v2 (optional third provider; activates only when a key is set)
SPORTS_API_KEY=
SPORTS_API_BASE=https://v2.football.sportsapipro.com/api

# Legacy aliases for the SportsAPI Pro key
FOOTBALL_API_KEY=
FOOTBALL_API_KEYS=

# -----------------------------------------------------------------------------
# Rate limiting
# -----------------------------------------------------------------------------
# Requests per minute per IP/user for general API routes.
API_RATE_LIMIT_MAX=120
# Requests per minute for expensive routes (AI analysis, search, etc.).
EXPENSIVE_RATE_LIMIT_MAX=20

# -----------------------------------------------------------------------------
# Credits / referrals
# -----------------------------------------------------------------------------
SIGNUP_CREDITS=3
REFERRAL_REWARD_CREDITS=2

# -----------------------------------------------------------------------------
# Whop (primary card provider)
# -----------------------------------------------------------------------------
# Create at https://whop.com/dashboard/developer and paste the account ID (biz_...).
WHOP_API_KEY=
WHOP_ACCOUNT_ID=
# Existing variant IDs for each plan (plan_...). Card checkout is disabled for a
# plan until its variant is configured.
WHOP_PLAN_MONTHLY_BASIC=
WHOP_PLAN_MONTHLY_PRO=
# Required for /api/payments/whop-webhook. The endpoint fails closed without it.
WHOP_WEBHOOK_SECRET=
WHOP_REDIRECT_URL=
WHOP_API_BASE=https://api.whop.com/api/v1

# -----------------------------------------------------------------------------
# Lemon Squeezy (fallback card provider)
# -----------------------------------------------------------------------------
LEMONSQUEEZY_API_KEY=
LEMONSQUEEZY_STORE_ID=
LEMONSQUEEZY_VARIANT_MONTHLY_BASIC=
LEMONSQUEEZY_VARIANT_MONTHLY_PRO=
# Required. The webhook endpoint refuses to run without it (fails closed).
LEMONSQUEEZY_WEBHOOK_SECRET=
LEMONSQUEEZY_REDIRECT_URL=

# -----------------------------------------------------------------------------
# TON payments
# -----------------------------------------------------------------------------
# Real production wallet address for receiving TON payments.
TON_RECEIVER_ADDRESS=
# Required for on-chain verification.
TONCENTER_API_KEY=
# Fallback TON-per-USD rate if the price API is unavailable (e.g. 0.23).
USD_TO_TON_RATE=0.23

# -----------------------------------------------------------------------------
# Engagement notifications
# -----------------------------------------------------------------------------
# Daily fixture digest, football news, live goal alerts, weekly recap and
# win-back/upgrade campaigns are sent by the built-in scheduler. Per-user
# preferences and quiet hours are managed from the bot (/settings, /timezone,
# /stop). No extra secrets are required.
NOTIFICATIONS_ENABLED=true

# -----------------------------------------------------------------------------
# Automation
# -----------------------------------------------------------------------------
# Secret for external automation triggers (n8n / GitHub Actions).
AUTOMATION_SECRET=
# Secret used by server-to-server admin endpoints.
ADMIN_API_KEY=

# -----------------------------------------------------------------------------
# Frontend (Vite) — must be prefixed with VITE_ to reach the browser.
# -----------------------------------------------------------------------------
VITE_SUPABASE_URL="YOUR_SUPABASE_URL"
VITE_SUPABASE_ANON_KEY="YOUR_SUPABASE_ANON_KEY"
VITE_TELEGRAM_BOT_USERNAME=
VITE_USD_TO_TON_RATE=0.23
